<Window x:Class="piogi_lab_2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:piogi_lab_2"
        mc:Ignorable="d"
        Title="Редактор противников" Height="600" Width="900">

    <Window.Background>
        <ImageBrush ImageSource="/Images/background.jpg" Stretch="UniformToFill"/>
    </Window.Background>

    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- левая колонка со списком противников -->
        <StackPanel Grid.Column="0">
            <TextBlock Text="Список противников" FontWeight="Bold"/>
            <ListBox x:Name="EnemiesListBox" Height="400" 
                     SelectionChanged="EnemiesListBox_SelectionChanged"/>
        </StackPanel>

        <!-- центральная колонка с полем ввода -->
        <StackPanel Grid.Column="1" Margin="10,0">
            <TextBlock Text="Имя противника:"/>
            <TextBox x:Name="NameBox" Margin="0,0,0,10"/>

            <TextBlock Text="Базовое здоровье:"/>
            <TextBox x:Name="BaseLifeBox" Margin="0,0,0,10"/>

            <TextBlock Text="Модификатор здоровья:"/>
            <TextBox x:Name="LifeModBox" Margin="0,0,0,10"/>

            <TextBlock Text="Базовое золото:"/>
            <TextBox x:Name="BaseGoldBox" Margin="0,0,0,10"/>

            <TextBlock Text="Модификатор золота:"/>
            <TextBox x:Name="GoldModBox" Margin="0,0,0,10"/>

            <TextBlock Text="Шанс появления:"/>
            <TextBox x:Name="SpawnChanceBox" Margin="0,0,0,10"/>

            <TextBlock Text="Иконка противника:"/>
            <Image x:Name="MainEnemyIcon" Height="64" Margin="0,0,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button x:Name="AddBtn" Content="Добавить" Width="90" Margin="5"/>
                
                <Button x:Name="DeleteBtn" Content="Удалить" Width="90" Margin="5"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,0">
                <Button x:Name="SaveBtn" Content="Сохранить список" Width="130" Margin="5"/>
                
                <Button x:Name="LoadBtn" Content="Загрузить список" Width="130" Margin="5"/>
            </StackPanel>
        </StackPanel>

        <!-- правая колонка: иконки -->
        <StackPanel Grid.Column="2">
            <TextBlock Text="Иконки противников" FontWeight="Bold"/>
            <Button x:Name="LoadIconsBtn" Content="Загрузить иконки" Margin="0,5"/>
            
            <ListBox x:Name="IconsListBox" Height="450" 
                     SelectionChanged="IconsListBox_SelectionChanged"/>
        </StackPanel>
    </Grid>
</Window>
